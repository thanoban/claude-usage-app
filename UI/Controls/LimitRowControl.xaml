<UserControl x:Class="ClaudeUsage.UI.Controls.LimitRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <StackPanel Margin="0,0,0,14">

        <!-- Label + Percentage row -->
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LabelText"
                       Grid.Column="0"
                       Foreground="#C8C8C8"
                       FontSize="12"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="PercentText"
                       Grid.Column="1"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </Grid>

        <!-- Progress bar track -->
        <Border Height="4"
                CornerRadius="2"
                Background="#14FFFFFF"
                Margin="0,0,0,4">
            <Border x:Name="ProgressBar"
                    Height="4"
                    CornerRadius="2"
                    HorizontalAlignment="Left"
                    MinWidth="2">
            </Border>
        </Border>

        <!-- Reset time -->
        <TextBlock x:Name="ResetText"
                   Foreground="#3D3D3D"
                   FontSize="10"
                   FontFamily="Segoe UI"/>

    </StackPanel>
</UserControl>
