<Window x:Class="ClaudeUsage.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClaudeUsage.UI.Controls"
        Title="Claude Usage"
        Width="310"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Icon button style (gear, refresh) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat text button style (Quit) -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Spinning animation for loading -->
        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RefreshRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#242424"
            CornerRadius="14"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1">

        <StackPanel>

            <!-- ══ HEADER ══ -->
            <Grid Margin="16,14,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status dot + title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="7" Height="7"
                             Fill="#22C55E"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="Claude Usage"
                               Foreground="#E8E8E8"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: gear button -->
                <Button x:Name="GearButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Click="GearButton_Click"
                        ToolTip="Settings">
                    <TextBlock Text="⚙" FontSize="13" Foreground="#888888"/>
                </Button>
            </Grid>

            <!-- ══ SEPARATOR ══ -->
            <Rectangle Height="1" Fill="#0FFFFFFF" Margin="0,0,0,0"/>

            <!-- ══ CONTENT AREA ══ -->
            <Grid Margin="16,14,16,0">

                <!-- Loading state -->
                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,10,0,10"
                            Visibility="Collapsed">
                    <TextBlock x:Name="LoadingText"
                               Text="⟳  Fetching usage..."
                               Foreground="#555555"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error state -->
                <StackPanel x:Name="ErrorPanel"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,8"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               Foreground="#EF4444"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <Button x:Name="UpdateKeyLink"
                            Content="Update session key →"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Click="GearButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#E8441A"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Limit rows -->
                <StackPanel x:Name="LimitsPanel">
                    <controls:LimitRowControl x:Name="Row1"/>
                    <controls:LimitRowControl x:Name="Row2"/>
                    <controls:LimitRowControl x:Name="Row3"/>
                </StackPanel>

            </Grid>

            <!-- ══ SEPARATOR ══ -->
            <Rectangle Height="1" Fill="#0FFFFFFF" Margin="0,4,0,0"/>

            <!-- ══ FOOTER ══ -->
            <Grid Margin="14,9,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Last updated -->
                <TextBlock x:Name="LastUpdatedText"
                           Grid.Column="0"
                           Text="—"
                           Foreground="#444444"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           VerticalAlignment="Center"/>

                <!-- Right controls -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Refresh button -->
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource IconButton}"
                            Click="RefreshButton_Click"
                            ToolTip="Refresh">
                        <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                        <Button.RenderTransform>
                            <RotateTransform x:Name="RefreshRotation" Angle="0"/>
                        </Button.RenderTransform>
                        <TextBlock Text="↺" FontSize="14" Foreground="#888888"/>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16"
                               Fill="#2AFFFFFF"
                               Margin="8,0"/>

                    <!-- Quit -->
                    <Button x:Name="QuitButton"
                            Style="{StaticResource TextButton}"
                            Content="Quit"
                            Click="QuitButton_Click"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
