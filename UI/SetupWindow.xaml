<Window x:Class="ClaudeUsage.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage – Setup"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputPasswordField" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="CaretBrush" Value="#E8441A"/>
            <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#A0E8441A"/>
                                <Setter Property="Background" Value="#14E8441A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenInputPasswordField" TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordField}">
            <Setter Property="Foreground" Value="#22C55E"/>
            <Setter Property="Background" Value="#1422C55E"/>
            <Setter Property="BorderBrush" Value="#4022C55E"/>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="#E8441A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5722"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C94010"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#303030"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Session card button style -->
        <Style x:Key="SessionCardButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AE8441A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40E8441A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25E8441A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#1E1E1E"
            CornerRadius="14"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <StackPanel Margin="24,22,24,24">

            <!-- Header: icon + title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Ellipse Width="32" Height="32" Margin="0,0,12,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF8C42" Offset="0"/>
                            <GradientStop Color="#E8441A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Connect to Claude"
                               Foreground="#E8E8E8"
                               FontFamily="Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Scanning your browsers…"
                               Foreground="#666666"
                               FontFamily="Segoe UI"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <!-- ══ SCANNING PANEL ════════════════════════════════════════ -->
            <StackPanel x:Name="ScanningPanel" Visibility="Visible">
                <Border Background="#0AFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ScanningIcon" Text="⟳" Foreground="#E8441A"
                                   FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinTransform" CenterX="8" CenterY="8"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="SpinTransform"
                                                Storyboard.TargetProperty="Angle"
                                                From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <TextBlock Text="Looking for Claude sessions in Chrome, Edge, Firefox…"
                                   Foreground="#888888"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══ ACCOUNTS PICKER PANEL ════════════════════════════════ -->
            <StackPanel x:Name="PickerPanel" Visibility="Collapsed">
                <TextBlock Text="FOUND SESSIONS — SELECT ONE"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,8"/>
                <ItemsControl x:Name="SessionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SessionCardButton}"
                                    Tag="{Binding}"
                                    Click="SessionCard_Click"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding BrowserName}"
                                                   Foreground="#E8E8E8"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding ProfileName}"
                                                   Foreground="#606060"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="→"
                                               Foreground="#E8441A"
                                               FontSize="16"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ManualEntryBtn"
                        Content="Enter manually instead"
                        Style="{StaticResource SecondaryButton}"
                        Click="ManualEntryBtn_Click"
                        Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ══ CONNECTING PANEL (auto-connecting single session) ════ -->
            <StackPanel x:Name="ConnectingPanel" Visibility="Collapsed">
                <Border Background="#0AE8441A" CornerRadius="8" Padding="12,10" BorderBrush="#30E8441A" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#E8441A" FontSize="14"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock x:Name="ConnectingBrowserText"
                                       Foreground="#E8E8E8"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Found your session — connecting…"
                                       Foreground="#888888"
                                       FontFamily="Segoe UI"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══ MANUAL ENTRY PANEL ════════════════════════════════════ -->
            <StackPanel x:Name="ManualPanel" Visibility="Collapsed">

                <!-- Session Key -->
                <TextBlock Text="SESSION KEY" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="SessionKeyBox"
                             Style="{StaticResource InputPasswordField}"
                             Margin="0,0,0,8"/>

                <!-- How-to hint -->
                <Border Background="#0AFFFFFF"
                        CornerRadius="7"
                        Padding="10,8"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="How to get your session key:"
                                   Foreground="#888888"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBlock Foreground="#666666"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   TextWrapping="Wrap">
                            <Run Text="1. Open Chrome → "/>
                            <Run Text="claude.ai" Foreground="#E8441A"/>
                            <LineBreak/>
                            <Run Text="2. Press F12 → Application tab"/>
                            <LineBreak/>
                            <Run Text="3. Cookies → sessionKey → copy value"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Organization ID -->
                <TextBlock Text="ORGANIZATION ID" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="OrgIdBox"
                             Style="{StaticResource InputPasswordField}"
                             Margin="0,0,0,4"/>

                <TextBlock x:Name="OrgIdAutoHint"
                           Text="✓  Auto-detected from Claude Code"
                           Foreground="#22C55E"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Margin="0,0,0,18"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="OrgIdManualHint"
                           Text="Enter your Organization UUID from claude.ai/settings/usage"
                           Foreground="#555555"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18"/>

                <Button x:Name="SaveBtn"
                        Content="Save &amp; Connect"
                        Style="{StaticResource SaveButton}"
                        Click="SaveButton_Click"/>
            </StackPanel>

            <!-- ══ ERROR (shared) ════════════════════════════════════════ -->
            <TextBlock x:Name="ErrorText"
                       Foreground="#EF4444"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>

        </StackPanel>
    </Border>
</Window>
