<Window x:Class="ClaudeUsage.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage – Setup"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="CaretBrush" Value="#E8441A"/>
            <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#A0E8441A"/>
                                <Setter Property="Background" Value="#14E8441A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenInputField" TargetType="TextBox" BasedOn="{StaticResource InputField}">
            <Setter Property="Foreground" Value="#22C55E"/>
            <Setter Property="Background" Value="#1422C55E"/>
            <Setter Property="BorderBrush" Value="#4022C55E"/>
        </Style>

        <Style x:Key="InputPasswordField" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="CaretBrush" Value="#E8441A"/>
            <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#A0E8441A"/>
                                <Setter Property="Background" Value="#14E8441A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="#E8441A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5722"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C94010"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#242424"
            CornerRadius="14"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <StackPanel Margin="24,22,24,24">

            <!-- Orange gradient circle icon -->
            <Ellipse Width="36" Height="36" Margin="0,0,0,12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF8C42" Offset="0"/>
                        <GradientStop Color="#E8441A" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <TextBlock Text="Connect to Claude"
                       Foreground="#E8E8E8"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Enter your session key to start"
                       Foreground="#666666"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,0,0,20"/>

            <!-- Session Key -->
            <TextBlock Text="SESSION KEY" Style="{StaticResource FieldLabel}"/>

            <PasswordBox x:Name="SessionKeyBox"
                         Style="{StaticResource InputPasswordField}"
                         Margin="0,0,0,8"/>

            <!-- Instructions panel -->
            <Border Background="#0AFFFFFF"
                    CornerRadius="7"
                    Padding="10,8"
                    Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="How to get your session key:"
                               Foreground="#888888"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <TextBlock Foreground="#666666"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               TextWrapping="Wrap">
                        <Run Text="1. Open Chrome → "/>
                        <Run Text="claude.ai" Foreground="#E8441A"/>
                        <LineBreak/>
                        <Run Text="2. Press F12 → Application tab"/>
                        <LineBreak/>
                        <Run Text="3. Cookies → sessionKey → copy value"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Organization ID -->
            <TextBlock Text="ORGANIZATION ID" Style="{StaticResource FieldLabel}"/>

            <TextBox x:Name="OrgIdBox"
                     Style="{StaticResource InputField}"
                     Margin="0,0,0,4"/>

            <!-- Auto-detected hint (green) -->
            <TextBlock x:Name="OrgIdAutoHint"
                       Text="✓  Auto-detected from Claude Code"
                       Foreground="#22C55E"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       Margin="0,0,0,18"
                       Visibility="Collapsed"/>

            <!-- Manual hint -->
            <TextBlock x:Name="OrgIdManualHint"
                       Text="Enter your Organization UUID from claude.ai/settings/usage"
                       Foreground="#555555"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <!-- Validation error -->
            <TextBlock x:Name="ErrorText"
                       Foreground="#EF4444"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"/>

            <Button x:Name="SaveBtn"
                    Content="Save &amp; Connect"
                    Style="{StaticResource SaveButton}"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </Border>
</Window>
